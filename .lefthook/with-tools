#!/bin/sh
# Runs a command with the tool versions pinned in mise.toml on PATH, even when
# mise isn't activated in the calling shell, as with IDE Git integrations and
# AI agents. Without mise, the command runs with PATH unchanged.
# Used by lefthook.yml.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise env 2>/dev/null)"
fi
exec "$@"
